type: coreBlock
name: Core Access Node
description: Provides access to items stored in the core. Items can be unloaded, but not inserted. Once placed, it cannot be moved unless destroyed.
size: 2
allowSpawn: false
unitType: mono
acceptsItems: false
requirements:[
graphite/80
plastanium/60
phase-fabric/100
silicon/300
]
requiresCoreZone: false
